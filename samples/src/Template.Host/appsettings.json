{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Expressions", "Serilog.Sinks.Async" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Debug",
        "Microsoft.EntityFrameworkCore": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/logs.log", 
                "rollingInterval": "Day", 
                "retainedFileCountLimit": 31, 
                "retainedFileTimeLimit": "31.00:00:00", 
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Conditional",
        "Args": {
          "expression": "StartsWith(SourceContext, 'Hospital.Fw.Mo.Logging.AopLog.LoggerAttribute')",
          "configureSink": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/aop/logs.log",
                "rollingInterval": "Day",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Conditional",
        "Args": {
          "expression": "StartsWith(EventId_Name, 'SqlSugarCoreExtensions')",
          "configureSink": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/sql/logs.log",
                "rollingInterval": "Day",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Job": "Data Source=job_task.db;Pooling=true"
  }
}
